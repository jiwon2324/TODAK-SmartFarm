erDiagram
  TB_USER {
    int user_id PK
    varchar login_id
    varchar password_hash
    varchar name
    varchar phone
    varchar email
    varchar role
    tinyint failed_count
    datetime locked_until
    tinyint is_active
    datetime created_at
    datetime updated_at
  }
  TB_FARM {
    int farm_id PK
    int owner_user_id FK
    varchar farm_name
    varchar region
    decimal area_m2
    varchar facility_type
    varchar culture_type
    varchar kma_station_id
    datetime created_at
  }
  TB_ZONE {
    int zone_id PK
    int farm_id FK
    varchar zone_code
    varchar zone_name
    decimal area_m2
    decimal x_from_m
    decimal x_to_m
    varchar description
  }
  TB_CROP_CYCLE {
    int cycle_id PK
    int farm_id FK
    varchar variety
    date transplant_date
    date end_date
    varchar current_stage
    decimal gdd_base_c
    decimal gdd_upper_c
    varchar status
  }
  TB_CROP_STD {
    int std_id PK
    int farm_id FK
    int zone_id FK
    varchar stage
    int version_no
    time day_start_time
    time night_start_time
    decimal day_temp_min
    decimal day_temp_max
    decimal night_temp_min
    decimal night_temp_max
    decimal humidity_min
    etc more_10_columns
  }
  TB_GATEWAY {
    int gateway_id PK
    int farm_id FK
    varchar gateway_code
    tinyint is_simulated
    varchar status
    datetime last_heartbeat_at
    int synced_std_version
  }
  TB_SENSOR {
    int sensor_id PK
    int farm_id FK
    int zone_id FK
    int gateway_id FK
    varchar sensor_code
    varchar metric
    varchar unit
    decimal valid_min
    decimal valid_max
    decimal spike_limit
    varchar install_note
    tinyint is_simulated
    etc more_2_columns
  }
  TB_SENSOR_DATA {
    bigint data_id PK
    int sensor_id FK
    datetime measured_at
    decimal value
    decimal value_min
    decimal value_max
    smallint sample_count
    varchar quality
    varchar msg_id
    tinyint is_buffered
    datetime received_at
  }
  TB_SENSOR_DATA_HOURLY {
    int sensor_id PK
    datetime hour_at PK
    decimal avg_value
    decimal min_value
    decimal max_value
    smallint ok_count
  }
  TB_DEVICE {
    int device_id PK
    int farm_id FK
    int zone_id FK
    int gateway_id FK
    varchar device_code
    varchar device_type
    varchar device_name
    varchar mode
    datetime manual_until
    varchar current_state
    datetime state_changed_at
    tinyint is_simulated
  }
  TB_CONTROL_RULE {
    int rule_id PK
    int farm_id FK
    varchar rule_code
    varchar rule_name
    int zone_id FK
    varchar metric
    varchar period
    varchar compare_op
    decimal on_threshold
    decimal off_threshold
    varchar target_device_type
    varchar action_on
    etc more_7_columns
  }
  TB_CONTROL_COMMAND {
    bigint command_id PK
    int device_id FK
    varchar action
    int duration_sec
    varchar source
    int rule_id FK
    int requested_by FK
    varchar idempotency_key
    varchar status
    tinyint retry_count
    varchar reason
    datetime requested_at
    etc more_2_columns
  }
  TB_CONTROL_LOG {
    bigint log_id PK
    int device_id FK
    bigint command_id FK
    varchar prev_state
    varchar new_state
    varchar changed_by
    datetime changed_at
  }
  TB_ALERT {
    bigint alert_id PK
    int farm_id FK
    int zone_id FK
    varchar alert_type
    varchar severity
    varchar dedupe_key
    varchar message
    varchar status
    int occur_count
    datetime first_at
    datetime last_at
    int acked_by FK
    etc more_1_columns
  }
  TB_ALERT_DELIVERY {
    bigint delivery_id PK
    bigint alert_id FK
    int user_id FK
    varchar channel
    varchar result
    tinyint try_count
    datetime sent_at
  }
  TB_BEEHIVE {
    int hive_id PK
    int cycle_id FK
    int zone_id FK
    date placed_date
    int replace_days
    date removed_date
  }
