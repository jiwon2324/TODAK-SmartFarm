    varchar station_id PK
    date obs_date PK
    decimal tavg_c
    decimal tmax_c
    decimal tmin_c
    decimal rain_mm
    decimal rh_pct
    decimal sunshine_hr
    decimal solar_mj_m2
    varchar missing_flags
    varchar source_file
    datetime imported_at
  }
  TB_GDD_DAILY {
    int cycle_id PK
    date calc_date PK
    varchar source PK
    varchar method
    decimal tavg_c
    decimal base_c
    decimal upper_c
    decimal gdd
    decimal cum_gdd
    decimal coverage_pct
    tinyint is_complete
    datetime calculated_at
  }
  TB_SETTING_HISTORY {
    bigint history_id PK
    varchar entity_type
    bigint entity_id
    varchar field_name
    varchar old_value
    varchar new_value
    int changed_by FK
    datetime changed_at
  }
  TB_USER_FARM {
    int user_id PK
    int farm_id PK
    datetime granted_at
  }
  TB_REFRESH_TOKEN {
    bigint token_id PK
    int user_id FK
    char token_hash
    char family_id
    datetime expires_at
    datetime revoked_at
    bigint replaced_by
    datetime created_at
  }
