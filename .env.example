# 이 파일을 .env로 복사한 뒤 모든 값을 바꾼다 (.env는 Git에 올라가지 않는다)
#   cp .env.example .env
# 무작위 값 만들기 예: openssl rand -base64 48

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=todak
DB_USER=todak
DB_PASSWORD=change-me-db
MYSQL_HOST_PORT=3307

# JWT 서명키 (32바이트 이상)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# MQTT 계정
MQTT_SERVER_PASSWORD=change-me-mqtt-server
MQTT_GW_PASSWORD=change-me-mqtt-gateway

# 운영(HTTPS)에서는 true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8088,http://localhost:5173

# 시연용 주기 조정 (기본: 규칙 60초, 무응답 판정 180초)
RULE_INTERVAL_MS=60000
STALE_SEC=180

# 시뮬레이터: 시작할 때 채울 과거 데이터 일수 (0이면 생략)
SIM_BACKFILL_DAYS=14
